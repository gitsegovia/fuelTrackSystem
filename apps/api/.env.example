# Copia este archivo a .env y rellena los valores.
# Estas variables serán usadas por docker-compose para configurar los contenedores.

NODE_ENV=development
PORT=3000

# Configuración de la Base de Datos
DB_DATABASE=fueltrack
DB_USER=postgres
DB_PASS=mysecretpassword
DB_HOST=db # ¡Importante! Este debe ser el nombre del servicio de la base de datos en docker-compose.yml
DB_PORT=5432
DB_HOST_PORT=5433 # solo para crear override y dar un puerto externo al servicio de la base de datos
DB_CONNECTOR=postgres
# SSL hacia Postgres (H-026, T-029). Ausente = sin SSL (default, compatible con
# el Postgres de docker-compose.yml/.demo/.verify, que no tienen SSL). Ponelo
# en "true" solo si tu Postgres lo exige (ej. un servicio gestionado en la nube).
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false   # solo si el certificado no es validable; default = lo rechaza

# Configuración para jwt
JWT_SECRET="clavesupersecreta(8678sdljkkljd54.)"

# Sesión / tokens (ADR-014)
SESSION_MAX_HOURS=24          # tope absoluto de la sesión desde el login, no se extiende al renovar
ACCESS_TOKEN_MINUTES=15       # vida del access token
REFRESH_GRACE_SECONDS=60      # ventana de gracia al renovar el refresh token (T-019)

# --- Configuración de Licencia ---
LICENSE_KEY=TU_CLAVE_DE_LICENCIA_AQUI
LICENSE_SERVER_URL=https://tu-servidor-de-licencias.com/api
FINGERPRINT_PATH=/etc/fueltrack/fingerprint # Ruta DENTRO del contenedor