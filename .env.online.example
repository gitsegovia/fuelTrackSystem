# Copiar a .env.online y completar.
# Usar junto con:
#   docker compose --env-file .env.online -f docker-compose.yml \
#     -f docker-compose.prod.yml -f docker-compose.online.yml up -d --build
#
# Demo online por túnel de Cloudflare (T-041) — ver vault
# 90-mantenimiento/Demo online con Cloudflare Tunnel.md. A diferencia de
# .env.prod.example: sin NET_IFACE (docker-compose.online.yml reemplaza el
# fingerprint real por el fixture de dev, no monta la MAC del host) y con
# puertos altos para no chocar con otros servicios en 3000-3007.
DB_USER=postgres
DB_PASS=GENERATE_A_STRONG_PASSWORD
DB_DATABASE=fueltrack
WEB_PORT=3110
STATION_PORT=3111
API_PORT=4110
# URL pública de la API — debe coincidir con el subdominio de la API en
# fueltrack-demo.yml (el túnel de Cloudflare). Se hornea en el build de web y
# station: si se corrige acá, hay que repetir el "up -d --build".
PUBLIC_API_URL=https://fueltrack-api.corecodeinnovation.com/graphql

# --- Solo si se usa docker-compose.online-cci.yml (T-065, opcional) ---
# Valida la licencia contra CCI Licencias de desarrollo (cci-lic-dev, modo
# CCI1) en vez del servidor legado de :4100. Sin estas dos variables (o sin
# agregar ese overlay al comando) la demo sigue en modo LEGACY, sin cambios.
#
# Ruta a la clave pública de cci-lic-dev (repo hermano "cci-licensing"), vista
# desde donde se corre "docker compose" — NO desde este archivo. Si se corre
# desde la raíz del monorepo (project_fuelTrack), el default ya sirve; desde
# un worktree (ft-wt/<area>) hay que agregar un nivel más (../../cci-licensing/...).
# CCI_LICENSE_PUBLIC_KEY_FILE=../cci-licensing/secrets/license-public.pem
#
# Clave de la instancia (G, "Demo FuelTrack web" en cci-lic-dev). La entrega
# José fuera de cualquier archivo versionado — NUNCA la pongas acá ni en
# ningún commit; esto es solo el nombre de la variable.
# CCI_LICENSE_KEY=CCI1....
